<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>jetbrains-plugin-fss</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>FSH Toolkit</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/qligier/jetbrains-plugin-fss">Quentin Ligier</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    A plugin that adds support for the FSH language, the IG Publisher and SUSHI tools, the <em>ig.ini</em> file, and
    also provides some FHIR utilities.

    <a href="https://github.com/qligier/jetbrains-plugin-fss">Source code</a> |
    <a href="https://github.com/qligier/jetbrains-plugin-fss/issues">Issues</a> |
    <a href="https://www.linkedin.com/in/qligier/">LinkedIn</a>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="plugin_with_json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="plugin_with_yaml.xml">org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileIconProvider implementation="ch.qligier.jetbrains.plugin.fss.common.FssIconProvider"/>

        <!-- The FSH language -->
        <lang.commenter language="FSH"
                        implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.FshCommenter"/>
        <fileType
                name="FSH"
                implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.FshFileType"
                fieldName="INSTANCE"
                language="FSH"
                extensions="fsh"/>

        <lang.parserDefinition language="FSH"
                               implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.language.parser.FshParserDefinition"/>
        <lang.psiStructureViewFactory language="FSH"
                                      implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.structure.FshStructureViewFactory"/>
        <lang.braceMatcher
                language="FSH"
                implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.structure.FshPairedBraceMatcher"/>
        <codeInsight.lineMarkerProvider
                language="FSH"
                implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.structure.FshLineMarkerProvider"/>
        <stubElementTypeHolder class="ch.qligier.jetbrains.plugin.fss.fsh.language.psi.FshTypes"
                               externalIdPrefix="fsh."/>
        <stubIndex implementation="ch.qligier.jetbrains.plugin.fss.fsh.language.psi.stubs.FshEntityNameIndex"/>
        <lang.syntaxHighlighterFactory
                language="FSH"
                implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.language.highlighter.FshSyntaxHighlighterFactory"/>
        <annotator
                language="FSH"
                implementationClass="ch.qligier.jetbrains.plugin.fss.fsh.language.highlighter.FshHighlightingAnnotator"/>
        <colorSettingsPage
                implementation="ch.qligier.jetbrains.plugin.fss.fsh.language.highlighter.FshColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/FshDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/FshDarcula.xml"/>

        <defaultLiveTemplates file="/fsh/liveTemplates.xml"/>
        <liveTemplateContext
                contextId="FSH"
                implementation="ch.qligier.jetbrains.plugin.fss.fsh.FshTemplateContextType"/>


        <!-- The ig.ini file -->
        <fileType
                name="ig.ini"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.IgIniFileType"
                fieldName="INSTANCE"
                language="IG_INI"
                fileNames="ig.ini"/>
        <localInspection
                language="IG_INI"
                shortName="IgIniMissingRequiredEntry"
                displayName="Missing [IG] section or required property"
                groupPath="FHIR"
                groupName="ig.ini"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.IgIniMissingRequiredEntryInspection"/>
        <localInspection
                language="IG_INI"
                shortName="IgIniUnsupportedSection"
                displayName="Section not supported by the IG Publisher"
                groupPath="FHIR"
                groupName="ig.ini"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.IgIniUnsupportedSectionInspection"/>
        <localInspection
                language="IG_INI"
                shortName="IgIniUnsupportedProperty"
                displayName="Property not supported by the IG Publisher"
                groupPath="FHIR"
                groupName="ig.ini"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.IgIniUnsupportedPropertyInspection"/>
        <lang.parserDefinition
                language="IG_INI"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.language.parser.IniParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="IG_INI"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.language.highlighter.IniSyntaxHighlighterFactory"/>
        <lang.commenter
                language="IG_INI"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.language.IniCommenter"/>
        <completion.contributor
                language="IG_INI"
                implementationClass="ch.qligier.jetbrains.plugin.fss.igini.IgIniCompletionContributor"/>

        <!-- The sushi-config.yaml file -->
        <!-- The inspection is only loaded when the YAML plugin is available -->
        <!-- The JSON schema provider factory is only loaded when the JSON plugin is available -->
    </extensions>
</idea-plugin>
